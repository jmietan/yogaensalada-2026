tice-play\"],\"htmlAttributes\":{\"aria-hidden\":\"true\"}} -->\n<span class=\"gb-text yc-practice-play\" aria-hidden=\"true\">\u25b6</span>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"ad004039\",\"tagName\":\"span\",\"globalClasses\":[\"yc-practice-duration\"],\"htmlAttributes\":{\"aria-hidden\":\"true\"}} -->\n<span class=\"gb-text yc-practice-duration\" aria-hidden=\"true\">06:00</span>\n<!-- /wp:generateblocks/text --></a>\n<!-- /wp:generateblocks/element -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"7d0e6dfb\",\"tagName\":\"h3\"} -->\n<h3 class=\"gb-text\">Warrior Flow</h3>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"42a46a3f\",\"tagName\":\"p\",\"globalClasses\":[\"yc-meta\"]} -->\n<p class=\"gb-text yc-meta\">6 min \u00b7 All Levels</p>\n<!-- /wp:generateblocks/text --></article>\n<!-- /wp:generateblocks/element --></div>\n<!-- /wp:generateblocks/element --></div>\n<!-- /wp:generateblocks/element --></section>\n<!-- /wp:generateblocks/element -->\n\n<!-- wp:generateblocks/element {\"uniqueId\":\"e5aa1c27\",\"tagName\":\"section\",\"globalClasses\":[\"yc-section\",\"yc-latest\"],\"metadata\":{\"patternName\":\"yogensalada-color/latest\",\"name\":\"Latest \u00b7 dynamic article grid\",\"categories\":[\"yogensalada-color\"]}} -->\n<section class=\"yc-section yc-latest\"><!-- wp:generateblocks/element {\"uniqueId\":\"4bf32789\",\"tagName\":\"div\",\"globalClasses\":[\"yc-shell\"]} -->\n<div class=\"yc-shell\"><!-- wp:generateblocks/element {\"uniqueId\":\"7198c935\",\"tagName\":\"div\",\"globalClasses\":[\"yc-section-heading\"]} -->\n<div class=\"yc-section-heading\"><!-- wp:generateblocks/element {\"uniqueId\":\"90468e1c\",\"tagName\":\"div\"} -->\n<div><!-- wp:generateblocks/text {\"uniqueId\":\"8ab68655\",\"tagName\":\"p\",\"globalClasses\":[\"yc-eyebrow\"]} -->\n<p class=\"gb-text yc-eyebrow\">NOURISH YOUR BODY</p>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"c710ce46\",\"tagName\":\"h2\"} -->\n<h2 class=\"gb-text\">Latest</h2>\n<!-- /wp:generateblocks/text --></div>\n<!-- /wp:generateblocks/element -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"84561a7a\",\"tagName\":\"a\",\"globalClasses\":[\"yc-button\",\"yc-outline\"],\"htmlAttributes\":{\"href\":\"/blog/\"}} -->\n<a class=\"gb-text yc-button yc-outline\" href=\"/blog/\">View All Articles <span aria-hidden=\"true\">\u2192</span></a>\n<!-- /wp:generateblocks/text --></div>\n<!-- /wp:generateblocks/element -->\n\n<!-- wp:query {\"queryId\":21,\"query\":{\"perPage\":4,\"pages\":0,\"offset\":0,\"postType\":\"post\",\"order\":\"desc\",\"orderBy\":\"date\",\"author\":\"\",\"search\":\"\",\"exclude\":[],\"sticky\":\"exclude\",\"inherit\":false,\"excludeCurrent\":null},\"className\":\"yc-posts\"} -->\n<div class=\"wp-block-query yc-posts\"><!-- wp:post-template {\"layout\":{\"type\":\"grid\",\"columnCount\":2}} -->\n<!-- wp:group {\"tagName\":\"article\",\"className\":\"yc-article\"} -->\n<article class=\"wp-block-group yc-article\"><!-- wp:post-featured-image {\"isLink\":true,\"aspectRatio\":\"1\",\"sizeSlug\":\"medium_large\"} /-->\n\n<!-- wp:group {\"className\":\"yc-article-copy\"} -->\n<div class=\"wp-block-group yc-article-copy\"><!-- wp:post-terms {\"term\":\"category\"} /-->\n\n<!-- wp:post-title {\"level\":3,\"isLink\":true} /-->\n\n<!-- wp:post-excerpt {\"moreText\":\"\",\"excerptLength\":19} /-->\n\n<!-- wp:read-more {\"content\":\"Read More \u2192\"} /--></div>\n<!-- /wp:group --></article>\n<!-- /wp:group -->\n<!-- /wp:post-template -->\n\n<!-- wp:query-no-results -->\n<!-- wp:paragraph -->\n<p>New articles are coming soon.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:query-no-results --></div>\n<!-- /wp:query --></div>\n<!-- /wp:generateblocks/element --></section>\n<!-- /wp:generateblocks/element -->\n\n<!-- wp:generateblocks/element {\"uniqueId\":\"0ba9eb04\",\"tagName\":\"section\",\"globalClasses\":[\"yc-about\"],\"metadata\":{\"patternName\":\"yogensalada-color/introduction\",\"name\":\"Introduction \u00b7 story and values\",\"categories\":[\"yogensalada-color\"]}} -->\n<section class=\"yc-about\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"http://yogaensalada-2026.local:8080/wp-content/themes/yogensalada-color/assets/images/hero.png\" alt=\"Yoga outdoors \u2014 replace with the supplied sunset meditation photograph\" loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"638\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:generateblocks/element {\"uniqueId\":\"e6d2ad7b\",\"tagName\":\"div\",\"globalClasses\":[\"yc-about-copy\"]} -->\n<div class=\"yc-about-copy\"><!-- wp:generateblocks/text {\"uniqueId\":\"c7835cdd\",\"tagName\":\"p\",\"globalClasses\":[\"yc-eyebrow\"]} -->\n<p class=\"gb-text yc-eyebrow\">WELCOME TO YOGA ENSALADA</p>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"730a12e1\",\"tagName\":\"h2\"} -->\n<h2 class=\"gb-text\">Hey! Awesome<br>you are Here!</h2>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"923e3bbe\",\"tagName\":\"p\"} -->\n<p class=\"gb-text\">Why YOGA ENSALADA? For the love of yoga, wellness, food, travel and other things. Sharing my yoga practice journey to a 400-hrs Transcendental Yoga and a lifelong passion for healthy living.</p>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"bc2daf26\",\"tagName\":\"a\",\"globalClasses\":[\"yc-button\",\"yc-green\"],\"htmlAttributes\":{\"href\":\"http://yogaensalada-2026.local:8080/index.php/about-us/\"}} -->\n<a class=\"gb-text yc-button yc-green\" href=\"http://yogaensalada-2026.local:8080/index.php/about-us/\">Read My Story <span aria-hidden=\"true\">\u2192</span></a>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/element {\"uniqueId\":\"f198b7ba\",\"tagName\":\"div\",\"globalClasses\":[\"yc-values\"]} -->\n<div class=\"yc-values\"><!-- wp:generateblocks/element {\"uniqueId\":\"f7abd40a\",\"tagName\":\"div\"} -->\n<div><!-- wp:generateblocks/text {\"uniqueId\":\"7ca0628a\",\"tagName\":\"p\",\"globalClasses\":[\"yc-value-icon\"],\"htmlAttributes\":{\"aria-hidden\":\"true\"}} -->\n<p class=\"gb-text yc-value-icon\" aria-hidden=\"true\">Yoga</p>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"83d55b38\",\"tagName\":\"h3\"} -->\n<h3 class=\"gb-text\">Yoga</h3>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"eb8775ea\",\"tagName\":\"p\",\"globalClasses\":[\"yc-meta\"]} -->\n<p class=\"gb-text yc-meta\">Move with intention</p>\n<!-- /wp:generateblocks/text --></div>\n<!-- /wp:generateblocks/element -->\n\n<!-- wp:generateblocks/element {\"uniqueId\":\"3cbdcd21\",\"tagName\":\"div\"} -->\n<div><!-- wp:generateblocks/text {\"uniqueId\":\"525292e6\",\"tagName\":\"p\",\"globalClasses\":[\"yc-value-icon\"],\"htmlAttributes\":{\"aria-hidden\":\"true\"}} -->\n<p class=\"gb-text yc-value-icon\" aria-hidden=\"true\">Food</p>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"e00e8b11\",\"tagName\":\"h3\"} -->\n<h3 class=\"gb-text\">Food</h3>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"ffff1a7f\",\"tagName\":\"p\",\"globalClasses\":[\"yc-meta\"]} -->\n<p class=\"gb-text yc-meta\">Nourish with love</p>\n<!-- /wp:generateblocks/text --></div>\n<!-- /wp:generateblocks/element -->\n\n<!-- wp:generateblocks/element {\"uniqueId\":\"9180413f\",\"tagName\":\"div\"} -->\n<div><!-- wp:generateblocks/text {\"uniqueId\":\"637a4d2a\",\"tagName\":\"p\",\"globalClasses\":[\"yc-value-icon\"],\"htmlAttributes\":{\"aria-hidden\":\"true\"}} -->\n<p class=\"gb-text yc-value-icon\" aria-hidden=\"true\">Mindful living</p>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"ccc7120b\",\"tagName\":\"h3\"} -->\n<h3 class=\"gb-text\">Mindful Living</h3>\n<!-- /wp:generateblocks/tex