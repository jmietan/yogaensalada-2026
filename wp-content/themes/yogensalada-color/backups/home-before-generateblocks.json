    "content": "<!-- wp:group {\"tagName\":\"main\",\"align\":\"full\",\"layout\":{\"type\":\"default\"}} -->\n<main class=\"wp-block-group alignfull\"><!-- wp:generateblocks/element {\"uniqueId\":\"b3025f1e\",\"tagName\":\"section\",\"globalClasses\":[\"yc-hero\"],\"metadata\":{\"patternName\":\"yogensalada-color/hero\",\"name\":\"Hero \u00b7 Eat Move Breathe Heal\",\"categories\":[\"yogensalada-color\"]}} -->\n<section class=\"yc-hero\"><!-- wp:generateblocks/element {\"uniqueId\":\"7f1eb559\",\"tagName\":\"div\",\"globalClasses\":[\"yc-hero-copy\"]} -->\n<div class=\"yc-hero-copy\"><!-- wp:generateblocks/text {\"uniqueId\":\"c2f8f99f\",\"tagName\":\"p\",\"globalClasses\":[\"yc-eyebrow\"]} -->\n<p class=\"gb-text yc-eyebrow\">A HEALTHIER HAPPIER YOU</p>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"179b542c\",\"tagName\":\"h1\",\"globalClasses\":[\"yc-hero-title\"]} -->\n<h1 class=\"gb-text yc-hero-title\"><span>Eat</span><span>Move</span><span>Breathe</span><span>Heal</span></h1>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"59e31801\",\"tagName\":\"p\",\"globalClasses\":[\"yc-hero-description\"]} -->\n<p class=\"gb-text yc-hero-description\">Yoga, food and mindful living<br>for a balanced life.</p>\n<!-- /wp:generateblocks/text -->\n\n<!-- wp:generateblocks/text {\"uniqueId\":\"b7e641fb\",\"tagName\":\"a\",\"globalClasses\":[\"yc-button\"],\"htmlAttributes\":{\"href\":\"#practice\"}} -->\n<a class=\"gb-text yc-button\" href=\"#practice\">Explore Now <span aria-hidden=\"true\">\u2192</span></a>\n<!-- /wp:generateblocks/text --></div>\n<!-- /wp:generateblocks/element -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"http://yogaensalada-2026.local:8080/wp-content/themes/yogensalada-color/assets/images/hero.png\" alt=\"Yoga practice outdoors in the mountains\" fetchpriority=\"high\" decoding=\"async\" width=\"1024